{
  "name": "sanad-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tests for the Sanad static site. The site itself has no build step and no runtime dependencies.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=site/assets/js/sanad-core.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.mjs",
    "serve": "node tests/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
